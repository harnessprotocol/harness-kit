{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": { "CONTEXT7_API_KEY": "sk-FAKE-context7" }
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/sse"
    },
    "scratch": {
      "type": "local",
      "command": ["deno", "run", "server.ts"],
      "enabled": false
    },
    "mystery": {
      "type": "carrier-pigeon"
    }
  }
}
